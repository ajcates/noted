{
  "name": "noted",
  "version": "0.10.0",
  "description": "A node.js based note editor that launches like live-server and has AI editing powers. Perfect for managing the notes in your project.",
  "main": "index.js",
  "workspaces": [
    "frontend",
    "server"
  ],
  "scripts": {
    "increment-build": "node scripts/bump-version.js build",
    "build:frontend": "npm run build --workspace=frontend",
    "build:server": "npm run build --workspace=server",
    "build": "npm run increment-build && npm run build:server && npm run build:frontend",
    "install-global": "npm install && npm run build && cd server && npm install -g .",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces",
    "test:e2e": "node e2e/noted-termux.e2e.cjs",
    "it": "npm run install-global && noted notes"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ajcates/noted.git"
  },
  "keywords": [],
  "author": "@ajcates",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/ajcates/noted/issues"
  },
  "homepage": "https://github.com/ajcates/noted#readme",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "dotenv": "^17.4.2"
  }
}
